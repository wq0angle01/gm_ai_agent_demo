# Copy to secrets.properties at the project root, then fill in real values.
# secrets.properties itself is git-ignored and never packaged into the jar.

# --- Aliyun RDS MySQL, used by the "mysql" profile ---
MYSQL_HOST=your-instance.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_DB=gm_demo
MYSQL_USER=your_account
MYSQL_PASSWORD=your_password

# --- AI keys, used from Phase B onwards ---
DEEPSEEK_API_KEY=sk-none
DASHSCOPE_API_KEY=sk-none
